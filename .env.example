# Copy to .env and fill in. Never commit the real .env.

# --- Sepolia deployment ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
PRIVATE_KEY=your-deployer-private-key-without-0x

# --- Contract verification (optional) ---
ETHERSCAN_API_KEY=your-etherscan-api-key

# --- Gas reporting (optional) ---
REPORT_GAS=false
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# --- Frontend (optional, consumed by the React app) ---
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress
VITE_DEPLOYMENT_BLOCK=0

# Separate funded Sepolia seed accounts (never put these in frontend env files)
SUPPLIER_PRIVATE_KEY=
WAREHOUSE_PRIVATE_KEY=
TRANSPORT_PRIVATE_KEY=
RETAILER_PRIVATE_KEY=
DEMO_PRODUCT_ID=1001
