# The deploy script writes src/config/deployment.json. Overrides are optional.
# VITE_CONTRACT_ADDRESS=
# VITE_CHAIN_ID=31337
# VITE_DEPLOYMENT_BLOCK=1
# Local public reads default to http://127.0.0.1:8545.
# For Sepolia set a browser-accessible public RPC URL, then restart/rebuild Vite.
# All VITE_ values are public. Never put wallet private keys here.
# VITE_RPC_URL=https://your-sepolia-rpc
